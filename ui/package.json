{
  "name": "celestrian-ui-tests",
  "version": "1.0.0",
  "description": "Celestrian UI integration tests",
  "type": "module",
  "scripts": {
    "test": "node --test js/tests/*.test.mjs",
    "test:playwright": "npx playwright test",
    "test:engine": "npx playwright test -c playwright.engine.config.js",
    "test:diff": "node differential/selftest.mjs && node differential/run.mjs",
    "test:all": "npm run test && npm run test:playwright && npm run test:engine && npm run test:diff"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "serve": "^14.2.5"
  },
  "license": "AGPL-3.0-only",
  "private": true
}
