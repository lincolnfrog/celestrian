        { "t": 50, "h": 50, "inner": 50, "run": 50, "rest": false },
        { "t": 150, "h": 150, "inner": 250, "run": 50, "rest": false },
        { "t": 199, "h": 199, "inner": 299, "run": 1, "rest": false },
        { "t": -1, "h": 199, "inner": 299, "run": 1, "rest": false }
      ] },
    { "name": "one-shot: two cells, context cycle 500", "segments": [[0, 100], [200, 300]], "origin": 0, "fold": 500,
      "probes": [
        { "t": 250, "h": 250, "inner": 250, "run": 250, "rest": true },
