  "continuity_origin_cases_note": "THE CONTINUITY RE-ANCHOR (time_maps.md §5; seam-model SM-4, 2026-09-23): the origin at which the inner position sounding at t0 under oldSegments (anchored at origin, folding on oldFold) keeps sounding under newSegments (folding on newFold) — the representative NEAREST the old origin modulo the new fold (a tie resolves below it), never the most recent pass. Stays when the new map drops the sounding position or a one-shot rests. src/heard_index.h continuityOriginFor/nearestRepresentative and ui/js/mock/maps.js continuityOriginFor/nearestRepresentative must agree.",
  "continuity_origin_cases": [
    { "name": "pure slide +1000 after 7 passes (odd): the old origin, not O + 7P", "oldSegments": [[1000, 3000]], "newSegments": [[2000, 4000]], "origin": 500, "t0": 17000, "oldFold": 2000, "newFold": 2000, "expected": 500 },
    { "name": "the same slide after 6 passes (even): the same answer", "oldSegments": [[1000, 3000]], "newSegments": [[2000, 4000]], "origin": 500, "t0": 15000, "oldFold": 2000, "newFold": 2000, "expected": 500 },
    { "name": "a free (sub-grid) slide +250 keeps the origin too", "oldSegments": [[1000, 3000]], "newSegments": [[1250, 3250]], "origin": 500, "t0": 17000, "oldFold": 2000, "newFold": 2000, "expected": 500 },
    { "name": "trim the head [0,4000) → [1000,4000) after 5 passes: the least whole-Q move (−1000, not +20000)", "oldSegments": [[0, 4000]], "newSegments": [[1000, 4000]], "origin": 0, "t0": 22500, "oldFold": 4000, "newFold": 3000, "expected": -1000 },
    { "name": "a cut that removes the sounding position: the origin stays", "oldSegments": [[0, 4000]], "newSegments": [[0, 1000], [2000, 3000]], "origin": 0, "t0": 13500, "oldFold": 4000, "newFold": 2000, "expected": 0 },
    { "name": "inner seam slide, the sounding cell unmoved: the origin stays", "oldSegments": [[0, 1000], [2000, 3000]], "newSegments": [[0, 1000], [2500, 3500]], "origin": 0, "t0": 8500, "oldFold": 2000, "newFold": 2000, "expected": 0 },
    { "name": "a sub-Q loop (P = Q/2) slid after 3 passes: the old origin (mod P, not mod Q)", "oldSegments": [[1000, 1500]], "newSegments": [[1100, 1600]], "origin": 0, "t0": 2800, "oldFold": 500, "newFold": 500, "expected": 0 },
    { "name": "a one-shot slide folds on its context cycle 6000, not its shot 4000", "oldSegments": [[0, 4000]], "newSegments": [[1000, 5000]], "origin": 100, "t0": 8100, "oldFold": 6000, "newFold": 6000, "expected": 100 },
    { "name": "a one-shot resting: nothing sounds, the origin stays", "oldSegments": [[0, 1000]], "newSegments": [[250, 1250]], "origin": 0, "t0": 2500, "oldFold": 4000, "newFold": 4000, "expected": 0 }
