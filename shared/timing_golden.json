  "period_law_cases_note": "THE PERIOD LAW (composition.md §3, I12), tree fixtures: own = map ▸ sequence ▸ (clip: duration | stack: LCM of children's contributions); contribution = (periodSource context || skipped || drifts) ? 0 : own; THE DRIFT CLAUSE (Q22): drifts = quantum > 0 && own > 0 && own % quantum != 0 && quantum % own != 0 && the node holds no active sequence (a song is exempt, map or not — S10); islandCycle = lcm(quantum || fallback, own(root)); the providers judge drift against the case's `quantum` (0 = nothing drifts). Nodes: {id, type, duration, window:[s,e], sequenceLen, audition, periodSource, children} — `audition` = the step audition index on a stack with a song (its derived map is that step's span; the fixture songs are one step, so the span is the whole song). src/period_law.h (both providers) and ui/js/timeline_model.js must agree.",
  "period_law_cases": [
    { "name": "plain island: two loops fold by LCM", "quantum": 1000, "fallback": 44100,
      "tree": [ { "id": "a", "type": "clip", "duration": 2000 }, { "id": "b", "type": "clip", "duration": 3000 } ],
      "expected": { "a": { "own": 2000, "contribution": 2000 }, "b": { "own": 3000, "contribution": 3000 }, "root": { "own": 6000, "contribution": 6000 } },
      "islandCycle": 6000, "skip": "a", "rootOwnSkipping": 3000 },
    { "name": "window wins: a 4000 take windowed to [1000,2000) presents 1000", "quantum": 1000, "fallback": 44100,
      "tree": [ { "id": "a", "type": "clip", "duration": 4000, "window": [1000, 2000] } ],
      "expected": { "a": { "own": 1000, "contribution": 1000 }, "root": { "own": 1000, "contribution": 1000 } },
      "islandCycle": 1000 },
    { "name": "one-shot: keeps its own period, contributes nothing (Q5)", "quantum": 1000, "fallback": 44100,
      "tree": [ { "id": "a", "type": "clip", "duration": 4000 }, { "id": "s", "type": "clip", "duration": 3000, "periodSource": "context" } ],
      "expected": { "a": { "own": 4000, "contribution": 4000 }, "s": { "own": 3000, "contribution": 0 }, "root": { "own": 4000, "contribution": 4000 } },
      "islandCycle": 4000 },
    { "name": "sequence: a stack's song is its period (steps concatenate, never LCM)", "quantum": 1000, "fallback": 44100,
      "tree": [ { "id": "g", "type": "stack", "sequenceLen": 5000, "children": [ { "id": "c1", "type": "clip", "duration": 2000 }, { "id": "c2", "type": "clip", "duration": 3000 } ] } ],
      "expected": { "g": { "own": 5000, "contribution": 5000 }, "c1": { "own": 2000, "contribution": 2000 }, "root": { "own": 5000, "contribution": 5000 } },
      "islandCycle": 5000 },
    { "name": "nested window shortens all the way up", "quantum": 1000, "fallback": 44100,
      "tree": [ { "id": "g", "type": "stack", "children": [ { "id": "c1", "type": "clip", "duration": 4000, "window": [0, 2000] }, { "id": "c2", "type": "clip", "duration": 6000 } ] }, { "id": "b", "type": "clip", "duration": 1000 } ],
      "expected": { "c1": { "own": 2000, "contribution": 2000 }, "g": { "own": 6000, "contribution": 6000 }, "root": { "own": 6000, "contribution": 6000 } },
      "islandCycle": 6000 },
    { "name": "one-shot stack with a song: own = its song (D2-5 ruling a), contribution 0", "quantum": 1000, "fallback": 44100,
      "tree": [ { "id": "g", "type": "stack", "periodSource": "context", "sequenceLen": 8000, "children": [ { "id": "c1", "type": "clip", "duration": 4000 } ] }, { "id": "b", "type": "clip", "duration": 2000 } ],
      "expected": { "g": { "own": 8000, "contribution": 0 }, "root": { "own": 2000, "contribution": 2000 } },
      "islandCycle": 2000 },
    { "name": "before Q exists the fallback seeds the cycle", "quantum": 0, "fallback": 44100,
      "tree": [ { "id": "a", "type": "clip", "duration": 2000 } ],
      "expected": { "a": { "own": 2000, "contribution": 2000 }, "root": { "own": 2000, "contribution": 2000 } },
      "islandCycle": 882000 },
    { "name": "an empty island cycles on Q alone", "quantum": 1000, "fallback": 44100,
      "tree": [],
      "expected": { "root": { "own": 0, "contribution": 0 } },
      "islandCycle": 1000 },
    { "name": "drift (Q22): a loop neither a multiple nor a divisor of Q keeps its own period, contributes 0, never widens the cycle", "quantum": 1000, "fallback": 44100,
      "tree": [ { "id": "a", "type": "clip", "duration": 1000 }, { "id": "k", "type": "clip", "duration": 1300 } ],
      "expected": { "a": { "own": 1000, "contribution": 1000 }, "k": { "own": 1300, "contribution": 0 }, "root": { "own": 1000, "contribution": 1000 } },
      "islandCycle": 1000, "skip": "a", "rootOwnSkipping": 0 },
    { "name": "drift (Q22): a divisor and a multiple of Q do not drift", "quantum": 1000, "fallback": 44100,
      "tree": [ { "id": "a", "type": "clip", "duration": 1000 }, { "id": "h", "type": "clip", "duration": 500 }, { "id": "m", "type": "clip", "duration": 3000 } ],
      "expected": { "h": { "own": 500, "contribution": 500 }, "m": { "own": 3000, "contribution": 3000 }, "root": { "own": 3000, "contribution": 3000 } },
      "islandCycle": 3000 },
    { "name": "drift (Q22): a group holding a drifting child — the group's own excludes it", "quantum": 1000, "fallback": 44100,
      "tree": [ { "id": "g", "type": "stack", "children": [ { "id": "c1", "type": "clip", "duration": 2000 }, { "id": "k", "type": "clip", "duration": 1300 } ] }, { "id": "b", "type": "clip", "duration": 1000 } ],
      "expected": { "c1": { "own": 2000, "contribution": 2000 }, "k": { "own": 1300, "contribution": 0 }, "g": { "own": 2000, "contribution": 2000 }, "root": { "own": 2000, "contribution": 2000 } },
      "islandCycle": 2000 },
    { "name": "drift (Q22): a stack whose window drifts contributes 0 (its content keeps its own)", "quantum": 1000, "fallback": 44100,
      "tree": [ { "id": "g", "type": "stack", "window": [0, 1300], "children": [ { "id": "c1", "type": "clip", "duration": 4000 } ] }, { "id": "b", "type": "clip", "duration": 1000 } ],
      "expected": { "c1": { "own": 4000, "contribution": 4000 }, "g": { "own": 1300, "contribution": 0 }, "root": { "own": 1000, "contribution": 1000 } },
      "islandCycle": 1000 },
    { "name": "drift (Q22): a song of incoherent length does NOT drift (S10 — exempt)", "quantum": 1000, "fallback": 44100,
      "tree": [ { "id": "g", "type": "stack", "sequenceLen": 1300, "children": [ { "id": "c1", "type": "clip", "duration": 1000 } ] } ],
      "expected": { "c1": { "own": 1000, "contribution": 1000 }, "g": { "own": 1300, "contribution": 1300 }, "root": { "own": 1300, "contribution": 0 } },
      "islandCycle": 13000 },
    { "name": "drift (Q22): a song under a step audition stays exempt (the derived window is a step of the song)", "quantum": 1000, "fallback": 44100,
      "tree": [ { "id": "g", "type": "stack", "sequenceLen": 1300, "audition": 0, "children": [ { "id": "c1", "type": "clip", "duration": 1000 } ] } ],
      "expected": { "g": { "own": 1300, "contribution": 1300 }, "root": { "own": 1300, "contribution": 0 } },
      "islandCycle": 13000 },
    { "name": "drift (Q22): a window over a song stays exempt (map or not)", "quantum": 1000, "fallback": 44100,
      "tree": [ { "id": "g", "type": "stack", "sequenceLen": 5000, "window": [0, 1300], "children": [ { "id": "c1", "type": "clip", "duration": 1000 } ] } ],
      "expected": { "g": { "own": 1300, "contribution": 1300 }, "root": { "own": 1300, "contribution": 0 } },
      "islandCycle": 13000 },
    { "name": "drift (Q22) worked example: Q handed to the drums and trimmed to [700, 3100) — the 1000 keys drift, the cycle is Q, not lcm 12000", "quantum": 2400, "fallback": 44100,
      "tree": [ { "id": "keys", "type": "clip", "duration": 1000 }, { "id": "drums", "type": "clip", "duration": 5000, "window": [700, 3100] } ],
      "expected": { "keys": { "own": 1000, "contribution": 0 }, "drums": { "own": 2400, "contribution": 2400 }, "root": { "own": 2400, "contribution": 2400 } },
      "islandCycle": 2400 },
    { "name": "drift (Q22): with no Q nothing drifts", "quantum": 0, "fallback": 44100,
      "tree": [ { "id": "a", "type": "clip", "duration": 1000 }, { "id": "k", "type": "clip", "duration": 1300 } ],
      "expected": { "a": { "own": 1000, "contribution": 1000 }, "k": { "own": 1300, "contribution": 1300 }, "root": { "own": 13000, "contribution": 13000 } },
      "islandCycle": 5733000 }
