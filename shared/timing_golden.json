  "inner_at_cases_note": "THE RENDER EQUATION (composition.md §2), stated once: h = (t − origin − a0) mod fold, inner = mapOffset(h) while h < shot, rest when h >= shot (a one-shot; fold below the shot reads as the shot), run = continuity from t (seam / shot end / rest end). src/timing.h innerAt and ui/js/time_map.js innerAt must agree.",
  "inner_at_cases": [
    { "name": "loop: single window [1000,2000) at origin 100, fold = shot", "segments": [[1000, 2000]], "origin": 100, "fold": 1000,
      "probes": [
        { "t": 1100, "h": 0, "inner": 1000, "run": 1000, "rest": false },
        { "t": 1600, "h": 500, "inner": 1500, "run": 500, "rest": false },
        { "t": 100, "h": 0, "inner": 1000, "run": 1000, "rest": false },
        { "t": 99, "h": 999, "inner": 1999, "run": 1, "rest": false }
      ] },
    { "name": "one-shot: same window, context cycle 4000 — fires at origin + a0, rests 3000", "segments": [[1000, 2000]], "origin": 100, "fold": 4000,
      "probes": [
        { "t": 1100, "h": 0, "inner": 1000, "run": 1000, "rest": false },
        { "t": 2100, "h": 1000, "inner": 1000, "run": 3000, "rest": true },
        { "t": 5099, "h": 3999, "inner": 3999, "run": 1, "rest": true },
        { "t": 5100, "h": 0, "inner": 1000, "run": 1000, "rest": false }
      ] },
    { "name": "loop: two cells [0,100)+[200,300) at origin 0 — runs stop at the seam", "segments": [[0, 100], [200, 300]], "origin": 0, "fold": 200,
